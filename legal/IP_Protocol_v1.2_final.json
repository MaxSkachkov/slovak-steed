  "patent_vs_trade_secret": {
    "rule": "If functionality can be reverse-engineered from the product → patent it. If it cannot be reverse-engineered → keep as trade secret.",
    "patent_candidates": [
      "body-weight steering mechanism",
      "modular 60-second swap interface",
      "domain randomization training method"
    ],
    "trade_secret_candidates": [
      "reward function parameters",
      "training curriculum specifics",
      "specific DR ranges"
    ]
  },
  "model_policy": {
    "trained_models": "treated as trade secrets",
    "storage": "private repository only",
    "sharing": "only under NDA",
    "file_types": [
      ".pth",
      ".onnx",
      ".pt",
      ".safetensors"
    ],
    "versioning": "DVC with private remote storage"
  },
  "fto_log": {
    "required": true,
    "file": "DEPENDENCY_LOCK.json (fto_log section)",

# Slovak Steed — .env.example
# ──────────────────────────────────────────────────────────────
# ИНСТРУКЦИЯ:
#   1. Скопировать: cp .env.example .env
#   2. Заполнить реальными значениями в .env
#   3. .env добавлен в .gitignore — никогда не коммитить!
#   4. Этот файл (.env.example) безопасно хранить в репо
# ──────────────────────────────────────────────────────────────

# ── MinIO (хранилище весов и артефактов) ──────────────────────
MINIO_USER=admin
MINIO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_16_CHARS

# ── PostgreSQL (MLflow backend) ───────────────────────────────
DB_USER=slovak_steed
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_16_CHARS
DB_NAME=slovak_steed_mlflow

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_BUCKET=slovak-steed-experiments

# ── Guardian v2 ───────────────────────────────────────────────
# КРИТИЧНО: сменить перед первым запуском!
GUARDIAN_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET_64_CHARS
GUARDIAN_INTERVAL=30

# Email-алерты (опционально, оставить пустым если не нужно)
GUARDIAN_ALERT_EMAIL=
GUARDIAN_ALERT_PASSWORD=
GUARDIAN_ALERT_TO=
